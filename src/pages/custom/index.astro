---
import Layout from "@layouts/Layout.astro"
import { buildCustomIndexPage } from "../../lib/custom_index_page.js"

// Direct loads of /custom render the same index body that /content/custom.json
// serves for client-side opens; the behaviour (delete buttons, category form)
// is wired up by script.js (InitCustomIndex).
const index = await buildCustomIndexPage()
---

<Layout title={index.title} description="User-created wiki pages" views="" updated="">
    <Fragment set:html={index.html} />
</Layout>
