---
import Layout from "@layouts/Layout.astro"
import { buildEditorPage } from "../../lib/editor_page.js"

// Direct loads of /custom/edit render the same editor body that
// /content/custom/edit.json serves for client-side opens; the editor logic
// (preview, save, delete) is wired up by script.js (InitCustomEditor).
const requestedAddress = Astro.url.searchParams.get("address") ?? ""
const editor = await buildEditorPage(Astro.url.origin, requestedAddress)
---

<Layout title={editor.title} description="Custom page editor" views="" updated="">
    <Fragment set:html={editor.html} />
</Layout>
