---
import Layout from "@layouts/Layout.astro";
import { buildWebSearchPage } from "../lib/websearch_page.js";

// Direct loads of /websearch render the same results body that
// /content/websearch.json serves for client-side opens (script.js swaps it
// into #pagecontent without a full reload).
const query = Astro.url.searchParams.get("query") || "";
const page = await buildWebSearchPage(Astro.url.origin, query);
---

<Layout title={page.title} description="Garry's Mod Wiki" views="" updated="">
  <Fragment set:html={page.html} />
</Layout>
